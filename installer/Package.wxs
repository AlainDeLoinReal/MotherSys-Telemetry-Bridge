<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MotherSys Telemetry Bridge" Manufacturer="MotherSys" Version="1.3.0" Language="1033" Scope="perUser" InstallerVersion="500" Compressed="yes" UpgradeCode="248FAE17-453C-42DD-8E21-21A2AA91E230">
    <MediaTemplate EmbedCab="yes"/>
    <Upgrade Id="248FAE17-453C-42DD-8E21-21A2AA91E230"><UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" OnlyDetect="yes" Property="EXISTING_BRIDGE"/></Upgrade>
    <Launch Condition="Installed OR NOT EXISTING_BRIDGE" Message="Uninstall the existing MSI Bridge using Windows Installed apps before installing this candidate. Other MotherSys versions are not removed automatically."/>
    <Property Id="ARPNOMODIFY" Value="1"/><Property Id="ARPNOREPAIR" Value="1"/>
    <Property Id="ARPHELPLINK" Value="https://github.com/AlainDeLoinReal/MotherSys-Telemetry-Bridge"/>
    <Property Id="START_WITH_WINDOWS" Value="0" Secure="yes"/>
    <Property Id="REMOVE_SAVED_DATA" Value="1" Secure="yes"/>
    <Property Id="REGISTER_ON_COMMIT" Value="0" Secure="yes"/>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="MotherSysFolder" Name="MotherSys">
        <Directory Id="TelemetryBridgeFolder" Name="TelemetryBridge"><Directory Id="INSTALLFOLDER" Name="R1.3"/></Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="BridgeMenuFolder" Name="MotherSys Telemetry Bridge">
      <Component Id="StartMenuShortcut" Guid="42F3B13B-2A9B-4B15-BA2C-D671D83190AF">
        <Shortcut Id="BridgeShortcut" Name="MotherSys Telemetry Bridge" Target="[INSTALLFOLDER]MotherSys.TelemetryBridge.exe" Arguments="--background" WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="RemoveBridgeMenu" On="uninstall"/>
        <!-- Standard RemoveFolder only removes empty directories; never recursively deletes other MotherSys files. -->
        <RemoveFolder Id="RemoveEmptyTelemetryRoot" Directory="TelemetryBridgeFolder" On="uninstall"/>
        <RemoveFolder Id="RemoveEmptyMotherSysRoot" Directory="MotherSysFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\MotherSys\TelemetryBridge\R1.3" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </Directory></StandardDirectory>
    <Feature Id="Bridge" Title="MotherSys Telemetry Bridge" Level="1"><ComponentGroupRef Id="BridgeFiles"/><ComponentRef Id="StartMenuShortcut"/></Feature>
    <Binary Id="LifecycleActions" SourceFile="$(var.ActionsPath)"/>
    <CustomAction Id="Choices" BinaryRef="LifecycleActions" DllEntry="Choices" Execute="immediate" Return="check"/>
    <CustomAction Id="PrepareRemoval" BinaryRef="LifecycleActions" DllEntry="PrepareRemoval" Execute="deferred" Impersonate="yes" Return="check"/>
    <CustomAction Id="RollbackLaunch" BinaryRef="LifecycleActions" DllEntry="RollbackLaunch" Execute="rollback" Impersonate="yes" Return="check"/>
    <CustomAction Id="RegisterLaunch" BinaryRef="LifecycleActions" DllEntry="RegisterLaunch" Execute="deferred" Impersonate="yes" Return="check"/>
    <CustomAction Id="LaunchBridge" FileRef="BridgeExe" ExeCommand="--background" Execute="immediate" Return="asyncNoWait"/>
    <InstallExecuteSequence>
      <Custom Action="Choices" Before="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE"/>
      <Custom Action="PrepareRemoval" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
      <Custom Action="RollbackLaunch" Before="RegisterLaunch" Condition="REGISTER_ON_COMMIT=&quot;1&quot;"/>
      <Custom Action="RegisterLaunch" After="InstallFiles" Condition="REGISTER_ON_COMMIT=&quot;1&quot;"/>
      <Custom Action="LaunchBridge" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE AND UILevel &gt;= 3"/>
    </InstallExecuteSequence>
  </Package>
</Wix>
